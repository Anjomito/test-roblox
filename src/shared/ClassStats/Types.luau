--!strict
-- กำหนด "รูปร่าง" ของข้อมูลคลาส (type) ไว้ที่เดียว
-- ทุกไฟล์คลาสจะใช้ type นี้ ถ้าลืมใส่ stat ตัวไหน ตัวตรวจ type ของ Luau จะเตือนทันที
-- แยกไฟล์นี้ออกมาเพื่อกัน require วนกันเอง (ไฟล์คลาส require ไฟล์นี้ ไม่ต้อง require init)

-- stat หลัก 4 ตัวของทุกคลาส
export type Stats = {
	ATK: number, -- พลังโจมตี ใช้คำนวณดาเมจกายภาพ
	HP: number, -- พลังชีวิตสูงสุด
	AGI: number, -- ความคล่องตัว (เช่น ความเร็วเคลื่อนที่/โจมตี)
	INT: number, -- สติปัญญา ใช้คำนวณพลังเวท
}

-- ข้อมูลของคลาสหนึ่งคลาส
export type ClassData = {
	name: string, -- ชื่อที่ใช้ในโค้ด ต้องตรงกับชื่อไฟล์ เช่น "Warrior"
	displayName: string, -- ชื่อที่แสดงให้ผู้เล่นเห็น
	role: string, -- บทบาทโดยย่อ เอาไว้แสดงในหน้าเลือกคลาส
	stats: Stats,
}

-- ModuleScript ต้องคืนค่าเสมอ ไฟล์นี้มีแค่ type จึงคืนตารางว่าง
return {}
